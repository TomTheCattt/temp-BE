# Neon Configuration
# Copy this file to .env and fill in your values

# Database (Neon PostgreSQL) - Auto-injected by Neon
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Better Auth (Neon Auth)
# Generate with: neon auth secret
BETTER_AUTH_SECRET=your-better-auth-secret-here
BETTER_AUTH_URL=https://your-branch-xxx.compute.us-east-2.aws.neon.tech

# Email (Resend, SendGrid, etc.)
RESEND_API_KEY=re_xxxxxxxxxxxxx

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:8081,exp://192.168.1.xxx:8081

# Logging
LOG_LEVEL=info

# Optional: Social Providers
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
