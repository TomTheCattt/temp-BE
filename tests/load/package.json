{
  "name": "instagram-clone-load-tests",
  "version": "1.0.0",
  "description": "k6 Load Tests for Instagram Clone Backend - Phase 12 Production Hardening",
  "scripts": {
    "load:feed": "k6 run tests/load/feed-load-test.js",
    "load:auth": "k6 run tests/load/auth-load-test.js",
    "load:post": "k6 run tests/load/post-load-test.js",
    "load:search": "k6 run tests/load/search-load-test.js",
    "load:ws": "k6 run tests/load/websocket-load-test.js",
    "load:media": "k6 run tests/load/media-load-test.js",
    "load:notification": "k6 run tests/load/notification-load-test.js",
    "load:user": "k6 run tests/load/user-load-test.js",
    "load:all": "k6 run tests/load/master-load-test.js",
    "load:smoke": "k6 run --vus 10 --duration 30s tests/load/master-load-test.js",
    "load:stress": "k6 run --env K6_SCENARIO=stress tests/load/master-load-test.js",
    "load:soak": "k6 run --env K6_SCENARIO=soak tests/load/master-load-test.js",
    "load:spike": "k6 run --env K6_SCENARIO=spike tests/load/master-load-test.js",
    "load:cloud": "k6 cloud tests/load/master-load-test.js",
    "report:html": "k6 run --out json=results.json tests/load/master-load-test.js && k6 report results.json --output report.html"
  },
  "devDependencies": {
    "k6": "^0.53.0"
  },
  "engines": {
    "node": ">=20"
  }
}