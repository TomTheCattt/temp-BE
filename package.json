{
  "name": "instagram-backend",
  "version": "0.1.0",
  "description": "Backend API for Instagram Clone iOS app - Neon Functions + PostgreSQL + Better Auth",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:ws": "tsx watch src/websocket/index.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "lint": "eslint src/",
    "test": "vitest",
    "test:contract": "tsx pact/verify-provider.ts",
    "test:contract:staging": "STAGING_API_URL=${STAGING_API_URL} tsx pact/verify-provider.ts",
    "test:contract:production": "PRODUCTION_API_URL=${PRODUCTION_API_URL} tsx pact/verify-provider.ts",
    "pact:publish": "tsx pact/publish-contracts.ts",
    "pact:can-i-deploy": "pact-broker can-i-deploy --pacticipant=instagram-backend --version=${GITHUB_SHA} --broker-base-url=${PACT_BROKER_URL} --broker-username=${PACT_BROKER_USERNAME} --broker-password=${PACT_BROKER_PASSWORD} --latest=true",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "neon:deploy": "neon deploy",
    "neon:dev": "neon dev",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:push": "drizzle-kit push",
    "drizzle:studio": "drizzle-kit studio"
  },
  "keywords": [
    "instagram",
    "neon",
    "hono",
    "typescript",
    "postgresql",
    "better-auth"
  ],
  "license": "MIT",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1162.0",
    "@aws-sdk/s3-request-presigner": "^3.1162.0",
    "@hono/node-server": "^2.1.6",
    "@hono/zod-validator": "^0.4.0",
    "@neon/config": "^1.11.2",
    "@neon/env": "^1.6.14",
    "@neon/functions": "^0.11.0",
    "@neon/realtime": "^0.1.0",
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/client": "^5.22.0",
    "@types/bcrypt": "^6.0.0",
    "@types/uuid": "^10.0.0",
    "bcrypt": "^6.0.0",
    "better-auth": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.4",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.0.0",
    "hono": "^4.13.16",
    "hono-rate-limiter": "^0.5.4",
    "jose": "^5.9.0",
    "mediasoup": "^3.15.3",
    "mediasoup-client": "^3.8.6",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "pg": "^8.23.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "sharp": "^0.33.5",
    "uuid": "^14.0.3",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@pact-foundation/pact": "^15.0.0",
    "@types/cors": "^2.8.17",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "js-yaml": "^4.1.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
