generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(uuid())
  firebaseUid         String?               @unique @map("firebase_uid")
  username            String               @unique
  fullName            String               @map("full_name")
  email               String               @unique
  phone               String?
  avatarUrl           String?              @map("avatar_url")
  bio                 String?
  website             String?
  isVerified          Boolean              @default(false) @map("is_verified")
  isPrivate           Boolean              @default(false) @map("is_private")
  postsCount          Int                  @default(0) @map("posts_count")
  followersCount      Int                  @default(0) @map("followers_count")
  followingCount      Int                  @default(0) @map("following_count")
  // Better Auth required fields
  name                String?              @map("name")
  emailVerified       Boolean              @default(false) @map("email_verified")
  image               String?              @map("image")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  blockedBy           Block[]              @relation("blocked")
  blocks              Block[]              @relation("blocker")
  closeFriendOf       CloseFriend[]        @relation("friend")
  closeFriends        CloseFriend[]        @relation("user")
  comments            Comment[]
  conversationMembers ConversationMember[]
  deviceTokens        DeviceToken[]
  following           Follow[]             @relation("follower")
  followers           Follow[]             @relation("following")
  likes               Like[]
  sentMessages        Message[]            @relation("sender")
  actorNotifs         Notification[]       @relation("actor")
  notifications       Notification[]       @relation("recipient")
  posts               Post[]
  reels               Reel[]
  savedPosts          SavedPost[]
  savedReels          SavedReel[]
  stories             Story[]
  settings            UserSettings?
  accounts            Account[]
  sessions            Session[]

  @@map("users")
}

model DeviceToken {
  id        String         @id @default(uuid())
  userId    String         @map("user_id")
  token     String         @unique
  platform  DevicePlatform @default(IOS)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

model Block {
  id        String   @id @default(uuid())
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")
  blocked   User     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  blocker   User     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@map("blocks")
}

model Post {
  id            String      @id @default(uuid())
  authorId      String      @map("author_id")
  caption       String?
  locationName  String?     @map("location_name")
  locationLat   Float?      @map("location_lat")
  locationLng   Float?      @map("location_lng")
  likesCount    Int         @default(0) @map("likes_count")
  commentsCount Int         @default(0) @map("comments_count")
  isSponsored   Boolean     @default(false) @map("is_sponsored")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  comments      Comment[]
  likes         Like[]
  mediaItems    MediaItem[]
  author        User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  savedBy       SavedPost[]

  @@index([authorId])
  @@index([createdAt(sort: Desc)])
  @@map("posts")
}

model MediaItem {
  id           String    @id @default(uuid())
  postId       String    @map("post_id")
  url          String
  thumbnailUrl String?   @map("thumbnail_url")
  type         MediaType
  width        Int?
  height       Int?
  duration     Float?
  sortOrder    Int       @default(0) @map("sort_order")
  post         Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("media_items")
}

model Like {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  postId    String?  @map("post_id")
  reelId    String?  @map("reel_id")
  commentId String?  @map("comment_id")
  createdAt DateTime @default(now()) @map("created_at")
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  reel      Reel?    @relation(fields: [reelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, reelId])
  @@unique([userId, commentId])
  @@map("likes")
}

model SavedPost {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  postId    String   @map("post_id")
  createdAt DateTime @default(now()) @map("created_at")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("saved_posts")
}

model Comment {
  id         String    @id @default(uuid())
  postId     String?   @map("post_id")
  reelId     String?   @map("reel_id")
  authorId   String    @map("author_id")
  text       String
  parentId   String?   @map("parent_id")
  likesCount Int       @default(0) @map("likes_count")
  createdAt  DateTime  @default(now()) @map("created_at")
  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent     Comment?  @relation("replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[] @relation("replies")
  post       Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  reel       Reel?     @relation(fields: [reelId], references: [id], onDelete: Cascade)
  likes      Like[]

  @@index([postId, createdAt])
  @@index([reelId, createdAt])
  @@index([parentId])
  @@map("comments")
}

model Story {
  id        String      @id @default(uuid())
  authorId  String      @map("author_id")
  createdAt DateTime    @default(now()) @map("created_at")
  expiresAt DateTime    @map("expires_at")
  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  items     StoryItem[]
  views     StoryView[]

  @@index([authorId])
  @@index([expiresAt])
  @@map("stories")
}

model StoryItem {
  id          String    @id @default(uuid())
  storyId     String    @map("story_id")
  mediaUrl    String    @map("media_url")
  type        MediaType
  duration    Float     @default(5)
  sortOrder   Int       @default(0) @map("sort_order")
  stickerType String?   @map("sticker_type")
  stickerData String?   @map("sticker_data")
  createdAt   DateTime  @default(now()) @map("created_at")
  story       Story     @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([storyId])
  @@map("story_items")
}

model StoryView {
  id       String   @id @default(uuid())
  storyId  String   @map("story_id")
  viewerId String   @map("viewer_id")
  viewedAt DateTime @default(now()) @map("viewed_at")
  story    Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, viewerId])
  @@map("story_views")
}

model Reel {
  id              String      @id @default(uuid())
  authorId        String      @map("author_id")
  videoUrl        String      @map("video_url")
  thumbnailUrl    String?     @map("thumbnail_url")
  caption         String?
  audioName       String?     @map("audio_name")
  audioArtist     String?     @map("audio_artist")
  audioCoverUrl   String?     @map("audio_cover_url")
  isOriginalAudio Boolean     @default(true) @map("is_original_audio")
  duration        Float
  likesCount      Int         @default(0) @map("likes_count")
  commentsCount   Int         @default(0) @map("comments_count")
  sharesCount     Int         @default(0) @map("shares_count")
  viewsCount      Int         @default(0) @map("views_count")
  createdAt       DateTime    @default(now()) @map("created_at")
  comments        Comment[]
  likes           Like[]
  author          User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  savedBy         SavedReel[]

  @@index([authorId])
  @@index([createdAt(sort: Desc)])
  @@map("reels")
}

model Conversation {
  id          String               @id @default(uuid())
  isGroup     Boolean              @default(false) @map("is_group")
  groupName   String?              @map("group_name")
  groupAvatar String?              @map("group_avatar")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  members     ConversationMember[]
  messages    Message[]

  @@map("conversations")
}

model ConversationMember {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  userId         String       @map("user_id")
  isMuted        Boolean      @default(false) @map("is_muted")
  lastReadAt     DateTime?    @map("last_read_at")
  joinedAt       DateTime     @default(now()) @map("joined_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             String             @id @default(uuid())
  conversationId String             @map("conversation_id")
  senderId       String             @map("sender_id")
  contentType    MessageContentType @map("content_type")
  textContent    String?            @map("text_content")
  mediaUrl       String?            @map("media_url")
  mediaThumbnail String?            @map("media_thumbnail")
  mediaDuration  Float?             @map("media_duration")
  referenceId    String?            @map("reference_id")
  replyToId      String?            @map("reply_to_id")
  status         MessageStatus      @default(SENT)
  createdAt      DateTime           @default(now()) @map("created_at")
  conversation   Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User               @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([senderId])
  @@map("messages")
}

model Notification {
  id               String           @id @default(uuid())
  recipientId      String           @map("recipient_id")
  actorId          String           @map("actor_id")
  type             NotificationType
  postId           String?          @map("post_id")
  reelId           String?          @map("reel_id")
  commentText      String?          @map("comment_text")
  postThumbnailUrl String?          @map("post_thumbnail_url")
  isRead           Boolean          @default(false) @map("is_read")
  createdAt        DateTime         @default(now()) @map("created_at")
  actor            User             @relation("actor", fields: [actorId], references: [id], onDelete: Cascade)
  recipient        User             @relation("recipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt(sort: Desc)])
  @@index([recipientId, isRead])
  @@map("notifications")
}

model UserSettings {
  userId           String   @id @map("user_id")
  language         String   @default("en")
  biometricEnabled Boolean  @default(true) @map("biometric_enabled")
  pushEnabled      Boolean  @default(true) @map("push_enabled")
  darkMode         Boolean  @default(false) @map("dark_mode")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model CloseFriend {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  friendId  String   @map("friend_id")
  createdAt DateTime @default(now()) @map("created_at")
  friend    User     @relation("friend", fields: [friendId], references: [id], onDelete: Cascade)
  user      User     @relation("user", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([userId])
  @@index([friendId])
  @@map("close_friends")
}

model SavedReel {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  reelId    String   @map("reel_id")
  createdAt DateTime @default(now()) @map("created_at")
  reel      Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reelId])
  @@map("saved_reels")
}

model PendingUpload {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  storagePath String   @map("storage_path")
  url         String
  confirmed   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([confirmed, createdAt])
  @@map("pending_uploads")
}

// Better Auth tables
model Account {
  id                    String  @id @default(uuid())
  userId                String  @map("user_id")
  accountId             String  @map("account_id")
  providerId            String  @map("provider_id")
  accessToken           String? @map("access_token")
  refreshToken          String? @map("refresh_token")
  idToken               String? @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  user                  User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  token        String   @unique
  expiresAt    DateTime @map("expires_at")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("verifications")
}

enum DevicePlatform {
  IOS
  ANDROID
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MessageContentType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  POST
  STORY
  REEL
  LIKE
}

enum MessageStatus {
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum NotificationType {
  LIKE
  COMMENT
  FOLLOW
  FOLLOW_REQUEST
  MENTION
  TAGGED_IN_POST
  STORY_MENTION
  LIVE_VIDEO
}
